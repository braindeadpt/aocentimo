    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.35.0",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "4.3.3",
    "tsx": "^4.20.0",
