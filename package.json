{
  "name": "aocentimo",
  "version": "0.1.0",
  "private": true,
  "description": "AO CÊNTIMO — literacia financeira para Portugal: salário líquido, IRS, crédito habitação, poupança e inflação. Cada número com fonte e data.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "ingest": "tsx scripts/ingest/index.ts",
    "ingest:daily": "tsx scripts/ingest/index.ts --daily",
    "ingest:monthly": "tsx scripts/ingest/index.ts --monthly",
    "derive": "tsx scripts/derive/index.ts",
    "validate:data": "tsx scripts/derive/freshness.ts",
    "ci": "npm run lint && npm run typecheck && npm run test:unit && npm run build",
    "audit": "node scripts/_mega-audit.mjs && node scripts/_overflow-sweep.mjs && node scripts/_sweep.mjs && node scripts/_lettering.mjs",
    "serve:out": "node scripts/_serve-static.mjs"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "d3-array": "3.2.4",
    "d3-interpolate": "3.0.1",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "gsap": "3.15.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/d3-array": "3.2.2",
    "@types/d3-interpolate": "3.0.4",
    "@types/d3-path": "3.1.1",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.2.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.35.0",
    "eslint-config-next": "16.3.5",
    "serve": "^14.2.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "5.0.1"
  }
}
